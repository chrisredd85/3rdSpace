# Database
DATABASE_URL=your_supabase_connection_string
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI planner
OPENAI_API_KEY=sk-...

# Ticketing integrations
EVENTBRITE_CLIENT_ID=your_eventbrite_client_id
EVENTBRITE_CLIENT_SECRET=your_eventbrite_client_secret
EVENTBRITE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/eventbrite/callback
EVENTBRITE_WEBHOOK_SECRET=your_eventbrite_webhook_signing_secret
LUMA_API_KEY=your_luma_api_key
LUMA_WEBHOOK_SECRET=your_luma_webhook_secret

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# Stripe Price IDs
STRIPE_PRICE_PAY_PER_EVENT=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...

# Pricing
PLATFORM_FEE_PER_EVENT=30.00
PLATFORM_FEE_PRO_MONTHLY=69.00
PLATFORM_FEE_PRO_ANNUAL=690.00

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal operations
ADMIN_EMAILS=ops@example.com,founder@example.com
WORKER_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-cron-secret
WORKER_BASE_URL=https://your-production-domain.com
SUPABASE_DB_PASSWORD=your_supabase_database_password_for_migrations

# Upstash Redis credentials. Either REST naming convention is accepted;
# UPSTASH_REDIS_REST_* takes precedence when both are set. KV_REST_API_*
# names are injected by Vercel's Upstash/KV marketplace integration.
# REDIS_URL is also accepted when it contains the Upstash password.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# REDIS_URL=

# Email (Optional - Resend)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="3rdPlace <noreply@auth.example.com>"
NOTIFICATIONS_FROM_EMAIL="3rdPlace <notifications@auth.example.com>"
OPPORTUNITY_FROM_EMAIL="3rdPlace Concierge <concierge@auth.example.com>"
BILLING_FROM_EMAIL="3rdPlace Billing <billing@auth.example.com>"
INVOICE_FROM_EMAIL="3rdPlace Billing <billing@auth.example.com>"
MESSAGE_FROM_EMAIL="3rdPlace Messages <messages@auth.example.com>"

# Creator Gmail outreach
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GMAIL_OAUTH_STATE_SECRET=replace-with-a-long-random-state-secret
EMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-random-secret

# Venue discovery enrichment
GOOGLE_PLACES_API_KEY=your_google_places_api_key
DISCOVERY_CLAIM_TOKEN_SECRET=replace-with-a-long-random-claim-secret

# Multi-channel outreach (Phase 4)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=MG...
TWILIO_INBOUND_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
VOICE_PROVIDER=bland
BLAND_API_KEY=your_bland_api_key
BLAND_VOICE_ID=maya

# Email (Optional - AWS SES for later)
AWS_SES_ACCESS_KEY=xxx
AWS_SES_SECRET_KEY=xxx

# Monitoring (Sentry)
# Browser DSN for client-side error capture. Optional locally; required in production.
NEXT_PUBLIC_SENTRY_DSN=
# Server DSN for route handlers, server components, and edge runtime capture.
SENTRY_DSN=
# Auth token used only during production builds to upload source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Invoices
INVOICE_TAX_RATE_PERCENTAGE=8.5

# Playwright Testing (optional, defaults to localhost:3000)
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
